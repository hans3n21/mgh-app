// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AiTone {
  PROFESSIONAL
  FRIENDLY
  CASUAL
  SHORT
  EMPATHIC
}

enum AiFormality {
  DU
  SIE
  AUTO
}

enum OrderType {
  GUITAR
  BODY
  NECK
  REPAIR
  PICKGUARD
  PICKUPS
  ENGRAVING
  FINISH_ONLY
}

enum OrderStatus {
  intake
  quote
  in_progress
  waiting_parts
  finishing
  setup
  awaiting_customer
  complete
  design_review
  draft
  awaiting_payment
}

enum Role {
  admin
  admin_no_feedback
  staff
}

model User {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  passwordHash     String
  role             Role              @default(staff)
  createdAt        DateTime          @default(now())
  orders           Order[]           @relation("UserOrders")
  messages         Message[]
  procurementItems ProcurementItem[]

  // NextAuth
  accounts Account[]
  sessions Session[]
  
  // Mail System
  mailAccounts MailAccount[]
  sentMails    Mail[]        @relation("UserSentMails")
  orderViews   OrderView[]

  // Tasks
  tasksAssigned OrderTask[] @relation("TaskAssignee")
  tasksCreated  OrderTask[] @relation("TaskCreator")

  notifications Notification[]
}

model Customer {
  id               String   @id @default(cuid())
  name             String
  email            String?
  // Zusätzliche Adressen desselben Kunden (z. B. alte + neue Adresse parallel).
  // Lowercase gespeichert, damit der Postgres `has`-Lookup im Mail-Sync greift.
  additionalEmails String[] @default([])
  phone            String?
  // Address fields
  addressLine1     String?
  postalCode       String?
  city             String?
  country          String?  @default("DE")
  createdAt        DateTime @default(now())
  orders           Order[]
  mails            Mail[]
}

model Order {
  id               String        @id // we use human IDs like ORD-2025-001
  title            String
  type             OrderType
  status           OrderStatus   @default(intake)
  createdAt        DateTime      @default(now())
  // Letzte fachliche Aktivitaet (Status/Specs/Bilder/Nachrichten/Aufgaben/Mail-Zuordnung).
  // Wird ueber lib/order-activity.ts gepflegt — Basis fuer "Liegt seit" in der Uebersicht.
  lastActivityAt   DateTime      @default(now())
  // Freitext "Naechster Schritt" — beantwortet in der Uebersicht "was ist hier als Naechstes dran?"
  nextStep         String?
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId       String?
  assignee         User?         @relation("UserOrders", fields: [assigneeId], references: [id])
  specs            OrderSpecKV[]
  images           OrderImage[]
  items            OrderItem[]
  messages         Message[]
  wcOrderId        String?
  // Abrechnung
  finalAmountCents Int?
  paymentStatus    String        @default("open") // open | deposit | paid
  paymentMethod    String?       // paypal | direktueberweisung (wenn bezahlt)
  depositAmountCents Int?
  // Zahlungsdaten fuer die Abrechnung (Abgleich Banking): werden beim Setzen
  // von Angezahlt/Bezahlt automatisch auf heute gesetzt, nachtraeglich editierbar.
  depositPaidAt    DateTime?
  paidAt           DateTime?
  // Versand kommt OBENDRAUF auf den Endbetrag (finalAmountCents bleibt ohne)
  // und geht beim Shop-Sync als eigene Versandposition mit.
  shippingCents    Int?
  extras           OrderExtra[]
  mails            Mail[]
  datasheets       Datasheet[]
  views            OrderView[]
  tasks            OrderTask[]
  fieldSuggestions OrderFieldSuggestion[]
  // DHL-Retourenlabel: Tracking-Infos fuer das zuletzt erstellte Ruecksende-Label.
  // Kein eigenes Modell, da pro Auftrag i.d.R. genau ein Label erzeugt wird.
  returnLabelTrackingNumber String?
  returnLabelCreatedAt      DateTime?
  returnLabelPdfPath        String?
  // Papierkorb: gesetzt heisst geloescht. Die Zeile bleibt samt Bildern,
  // Datenblatt und Nachrichten erhalten, bis sie endgueltig entfernt wird.
  // Alle Listen und Zaehler filtern auf deletedAt: null.
  deletedAt        DateTime?

  @@index([deletedAt])
}

model OrderView {
  id             String    @id @default(cuid())
  orderId        String
  userId         String
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, userId])
  @@index([userId])
}

model OrderSpecKV {
  id      String @id @default(cuid())
  orderId String
  key     String
  value   String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderImage {
  id        String   @id @default(cuid())
  orderId   String
  path      String // file path or URL
  comment   String?
  position  Int      @default(0)
  attach    Boolean  @default(false)
  scope     String? // categorization: body, neck, finish, repair, pickguard, pickups, engraving
  fieldKey  String? // optional link to specific field
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Message {
  id         String   @id @default(cuid())
  orderId    String
  senderId   String? // if staff: userId; if customer: null and senderType=customer
  senderType String   @default("staff") // "staff" | "customer"
  body       String
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender     User?    @relation(fields: [senderId], references: [id])
}

model PriceItem {
  id           String      @id @default(cuid())
  category     String
  label        String
  description  String?
  unit         String?
  price        Int?
  min          Int?
  max          Int?
  priceText    String?
  mainCategory String?
  active       Boolean     @default(true)
  orderItems   OrderItem[]
}

model OrderItem {
  id          String     @id @default(cuid())
  orderId     String
  priceItemId String?
  label       String
  qty         Int        @default(1)
  unitPrice   Int        @default(0)
  total       Int        @default(0)
  notes       String?
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  priceItem   PriceItem? @relation(fields: [priceItemId], references: [id])

  @@index([orderId])
}

model OrderExtra {
  id          String   @id @default(cuid())
  orderId     String
  label       String
  amountCents Int
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderTask {
  id          String    @id @default(cuid())
  orderId     String
  assigneeId  String
  creatorId   String
  title       String
  note        String?
  status      String    @default("open") // open | done
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignee    User      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User      @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([assigneeId])
  @@index([orderId])
}

// In-App-Benachrichtigungen (Badge im Header): Aufgabe zugewiesen,
// Auftrag zugewiesen, neue Mail zu einem eigenen Auftrag.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // task_assigned | order_assigned | order_mail
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ProcurementItem {
  id         String    @id @default(cuid())
  name       String
  qty        Int       @default(1)
  unit       String?   @default("Stk")
  status     String    @default("offen") // offen|bestellt|archiviert
  neededBy   DateTime?
  note       String?
  link       String?
  orderId    String?
  createdBy  String? // User ID who created this item
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime? // When item was archived
  creator    User?     @relation(fields: [createdBy], references: [id])
}

/// NextAuth models (Prisma Adapter)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MailAccount {
  id        String   @id @default(cuid())
  name      String   // e.g. "Support"
  email     String   @unique
  
  // Configuration
  imapHost  String
  imapPort  Int      @default(993)
  imapUser  String
  imapPass  String   
  smtpHost  String
  smtpPort  Int      @default(587)
  smtpUser  String
  smtpPass  String
  
  // State
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  
  mails            Mail[]
  profile          MailAccountProfile?
  aiProfile        AiProfile?
  emailTemplates   EmailTemplate[]
  knowledgeEntries KnowledgeEntry[]
  companyData      CompanyData[]
  // Optional: Link to specific staff user
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MailAccountProfile {
  id               String   @id @default(cuid())
  mailAccountId    String   @unique
  mailAccount      MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  displayName      String?
  aiSystemPrompt   String?  @db.Text
  backgroundInfo   String?  @db.Text
  defaultLanguage  String   @default("de")
  defaultOrderType String?
  templateIds      String[]
  pinnedFolders    String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Mail {
  id             String       @id @default(cuid())
  messageId      String
  threadId       String?      // Root message ID for conversation grouping
  
  // Multi-Account Context
  accountId      String
  account        MailAccount  @relation(fields: [accountId], references: [id])

  // IMAP State
  uid            Int          
  folder         String       // "INBOX", "TRASH", "Sent", "Drafts"
  
  // Content
  subject        String?
  fromEmail      String
  fromName       String?
  // Reply-To Header, falls abweichend von fromEmail -- z. B. Kontaktformular-Mails,
  // die technisch von der eigenen Absenderadresse verschickt werden (SPF/DKIM),
  // aber die echte Kundenadresse im Reply-To tragen.
  replyToEmail   String?
  toEmail        String?      // Primary recipient email (for display in sent folder)
  toName         String?      // Primary recipient name
  to             Json         // Array of strings (all recipients)
  cc             Json?
  bcc            Json?
  text           String?      @db.Text
  html           String?      @db.Text
  snippet        String?
  
  // Metadata
  date           DateTime
  inReplyTo      String?
  references     Json?        
  
  // Associations
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  senderId       String?      // Staff member who sent this
  sender         User?        @relation("UserSentMails", fields: [senderId], references: [id])

  attachments    Attachment[]
  extraction     MailExtraction?
  
  isRead         Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  starred        Boolean      @default(false)
  tags           String[]     @default([])

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Per-account unique constraint (messageId is unique within one mail account)
  @@unique([accountId, messageId])

  // Performance Indices
  @@index([orderId])
  @@index([folder])
  @@index([threadId])
  @@index([customerId])
  @@index([fromEmail])
  @@index([date])
  @@index([accountId, folder, isDeleted, date])
}

model Attachment {
  id          String   @id @default(cuid())
  mailId      String
  mail        Mail     @relation(fields: [mailId], references: [id], onDelete: Cascade)
  filename    String
  mimeType    String?
  size        Int
  path        String?  // Blob URL or local path — null when not yet persisted
  cid         String?  // Content-ID for inline images

  // On-demand fetch: set during sync so we can re-fetch from IMAP when not persisted
  isPersisted Boolean  @default(false)
  imapFolder  String?  // e.g. "INBOX" — folder the source mail lives in
  imapUid     Int?     // IMAP UID of the source message

  createdAt   DateTime @default(now())
}

model MailExtraction {
  id        String   @id @default(cuid())
  mailId    String   @unique
  mail      Mail     @relation(fields: [mailId], references: [id], onDelete: Cascade)
  entities  Json
  createdAt DateTime @default(now())

  @@index([mailId])
}

model OrderFieldSuggestion {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field      String
  value      String
  mailId     String?
  status     String    @default("suggested")
  acceptedBy String?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orderId])
  @@index([mailId])
}

model SystemSetting {
  key   String @id
  value String // JSON value
}

// Embedding-Cache fuer semantisches Wissens-Matching (lib/ai/semantic-matcher.ts).
// entryId verweist auf GlobalKnowledgeEntry.id oder KnowledgeEntry.id (kein FK,
// da zwei Quelltabellen); contentHash invalidiert bei Inhaltsaenderung.
model KnowledgeEmbedding {
  entryId     String   @id
  contentHash String
  embedding   Json
  updatedAt   DateTime @updatedAt
}

model Datasheet {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Feedback {
  id        String   @id @default(cuid())
  message   String
  page      String
  url       String
  timestamp DateTime
  userAgent String?
  resolved  Boolean  @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  
  @@index([resolved])
  @@index([createdAt])
}

model ReplyTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  lang      String   @default("de")
  subject   String?
  body      String
  variables Json?    // Array von Variablen-Namen für Template-Platzhalter
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([lang])
  @@index([key])
}

model AiProfile {
  id                    String      @id @default(cuid())
  mailAccountId         String      @unique
  mailAccount           MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  tone                  AiTone      @default(FRIENDLY)
  formality             AiFormality @default(DU)
  signatureName         String      @default("")
  customInstructions    String?     @db.Text
  businessContext       String?     @db.Text
  generatedStyleProfile String?     @db.Text
  preferredModel        String      @default("gpt-4o-mini")
  preferredProvider     String      @default("openai")
  apiKey                String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model EmailTemplate {
  id            String      @id @default(cuid())
  mailAccountId String
  mailAccount   MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  key           String
  name          String
  subject       String?
  body          String      @db.Text
  placeholders  String[]
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([mailAccountId, key])
  @@index([mailAccountId])
}

model KnowledgeEntry {
  id            String      @id @default(cuid())
  mailAccountId String
  mailAccount   MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  title         String
  keywords      String[]
  content       String      @db.Text
  category      String?
  isActive      Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([mailAccountId])
}

model GlobalKnowledgeEntry {
  id          String   @id @default(cuid())
  title       String
  keywords    String[]
  content     String   @db.Text
  category    String?
  status      String   @default("review")
  kiFreigabe  Boolean  @default(false)
  isActive    Boolean  @default(false)
  sourcePath  String?
  sortOrder   Int      @default(0)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, kiFreigabe, isActive])
  @@index([category])
  @@index([sortOrder])
}

model CompanyData {
  id            String      @id @default(cuid())
  mailAccountId String
  mailAccount   MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)
  key           String      // z.B. "iban", "telefon", "firmenname", "signatur_de"
  label         String      // Anzeigename, z.B. "Bankverbindung (IBAN)"
  value         String      @db.Text
  isSecret      Boolean     @default(true)  // true = geht NIE in den KI-Prompt
  category      String?     // "kontakt", "bank", "signatur", "sonstiges"
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([mailAccountId, key])
  @@index([mailAccountId])
}
